DEBUG=1
SECRET_KEY=93838388383
DB_URL=postgres://postgres:jajrjr@localhost:5432/talentsync2
EMAIL_HOST=<smtp host>
EMAIL_PORT=<smtp port>
EMAIL_USER=<smtp user>
EMAIL_PASSWORD=<email password>

# Email providers — Resend is primary, Mailgun is the fallback
RESEND_API_KEY=<re_... key from resend.com dashboard>
# Optional overrides (defaults shown; from-domain must be verified in Resend)
# RESEND_FROM_EMAIL=Tiaago <support@email.tiaago.com>
# RESEND_SECURITY_EMAIL=Tiaago <verify@email.tiaago.com>
# RESEND_REPLY_TO=support@email.tiaago.com
# Signing secret for the Resend webhook (dashboard -> Webhooks), web service only
RESEND_WEBHOOK_SECRET=<whsec_...>
MAILGUN_DOMAIN=<mailgun sending domain, e.g. mg.tiaago.com>
MAILGUN_API_KEY=<mailgun private api key>
# Google OAuth (Sign in with Google)
GOOGLE_CLIENT_ID=

PAYSTACK_PUBLIC_KEY=<paystack publick key>
PAYSTACK_PRIVATE_KEY=<paystack private key>
CURRENCY_PRIVATE_KEY=''
DAILY_API_TOKEN=''
REDIS_HOST='tiaago_redis_server'
FLW_SEC_KEY=''
FLW_PUB_KEY=''
PAYSTACK_BASIC_PLAN_CODE_FOR_TALENTS=''
PAYSTACK_PREMIUM_PLAN_CODE_FOR_TALENTS=''
PAYSTACK_BASIC_PLAN_CODE_FOR_STARTUPS=''
PAYSTACK_PREMIUM_PLAN_CODE_FOR_STARTUPS=''
FLW_BASIC_PLAN_CODE_FOR_TALENTS=''
FLW_PREMIUM_PLAN_CODE_FOR_TALENTS=''
FLW_BASIC_PLAN_CODE_FOR_STARTUPS=''
FLW_PREMIUM_PLAN_CODE_FOR_STARTUPS=''
ENV=development
ALLOWED_HOSTS=127.0.0.1

# Both default to https://www.tiaago.com/ if unset -- for local dev, set
# these to your local frontend URL or every generated link (job apply URLs,
# email links, etc.) will point at production instead of localhost.
FRONTEND_URL=http://localhost:3000/
FRONTEND_BASE_URL=http://localhost:3000

# Defaults to http://localhost:8000 if unset -- this backend's own public
# origin, used for campaign email tracking-pixel/click-redirect URLs.
BASE_URL=http://localhost:8000

CLOUDINARY_CLOUD_NAME='YOUR_CLOUDINARY_CLOUD_NAME'
CLOUDINARY_API_KEY='YOUR_CLOUDINARY_API_KEY'
CLOUDINARY_API_SECRET='YOUR_CLOUDINARY_API_SECRET'

# Inter-service auth (AI service)
AI_SERVICE_BASE_URL=http://localhost:9000/api/v1
AI_SERVICE_API_KEY=

# Sentry (production only)
SENTRY_DSN=

# BetterStack log management
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_HOST=

# Uptime monitoring — secret for /api/health/ (cron-job.org sends it as the
# X-Health-Key header). Leave empty locally to disable the auth check.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
HEALTHCHECK_SECRET=
