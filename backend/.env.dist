DEBUG=<1 or 0>
SECRET_KEY=<secret key>
DB_NAME=<db name>
DB_USER=<db user>
DB_PASSWORD=<db password>
DB_HOST=<db host>
DB_PORT=<dbport>
DB_URL=<your database url>
EMAIL_HOST=<smtp host>
EMAIL_PORT=<smtp port>
EMAIL_USER=<smtp user>
EMAIL_PASSWORD=<email password>
RESEND_API_KEY=<resend api key (primary email provider)>
RESEND_WEBHOOK_SECRET=<resend webhook signing secret>
MAILGUN_DOMAIN=<mailgun sending domain (fallback email provider)>
MAILGUN_API_KEY=<mailgun private api key>
PAYSTACK_PUBLIC_KEY=<paystack publick key>
PAYSTACK_PRIVATE_KEY=<paystack private key>
# Bachs (default wallet top-up gateway) -- app.bachs.io > Developer > API Keys
BACHS_ENVIRONMENT=<sandbox or live>
BACHS_API_KEY_SANDBOX=<sk_sandbox_...>
BACHS_API_KEY_LIVE=<sk_live_..., after account verification>
BACHS_WEBHOOK_SECRET=<Bachs dashboard > Webhooks > signing secret>
BACHS_TOPUP_PRODUCT_ID_NGN=<prod_... NGN top-up product id>
BACHS_TOPUP_PRODUCT_ID_USD=<prod_... USD top-up product id>
ENV=<development or staging or production>
ALLOWED_HOSTS=<allowed hosts, seperated by a comma, with no spaces>
# Both default to https://www.tiaago.com/ if unset -- for local dev, set
# these to your local frontend URL (e.g. http://localhost:3000/) or every
# generated link (job apply URLs, email links, etc.) will point at production.
FRONTEND_URL=<your frontend base url, e.g. http://localhost:3000/>
FRONTEND_BASE_URL=<same as FRONTEND_URL, without the trailing slash>
# The Django backend's own public origin (defaults to http://localhost:8000
# if unset) -- used by campaign emails to build tracking-pixel and
# click-tracking redirect URLs, which are backend API routes, not frontend
# routes.
BASE_URL=<your backend base url, e.g. https://api.tiaago.com>
CURRENCY_PRIVATE_KEY=<currency private key>
DAILY_API_TOKEN=<daily api token>
# AI interview feature (LiveKit + interview_agent/) -- see interview_agent/.env.example
LIVEKIT_URL=<e.g. wss://your-project.livekit.cloud>
LIVEKIT_API_KEY=<livekit api key>
LIVEKIT_API_SECRET=<livekit api secret>
INTERNAL_API_KEY=<random 32-char secret, shared with interview_agent/>
AI_INTERVIEW_MAX_CONCURRENT_SESSIONS=<how many concurrent AI interviews the interview_agent/ fleet can handle, e.g. 5>
REDIS_HOST=<redis host>
PAYSTACK_PRIVATE_KEY=<for payments>
PAYSTACK_PUBLIC_KEY=<for payments>
FLW_SEC_KEY=<for payments>
FLW_PUB_KEY=<for payments>
PAYSTACK_BASIC_PLAN_CODE_FOR_TALENTS=<for payments>
PAYSTACK_PREMIUM_PLAN_CODE_FOR_TALENTS=<for payments>
PAYSTACK_BASIC_PLAN_CODE_FOR_STARTUPS=<for payments>
PAYSTACK_PREMIUM_PLAN_CODE_FOR_STARTUPS=<for payments>
FLW_BASIC_PLAN_CODE_FOR_TALENTS=<for payments>
FLW_PREMIUM_PLAN_CODE_FOR_TALENTS=<for payments>
FLW_BASIC_PLAN_CODE_FOR_STARTUPS=<for payments>
FLW_PREMIUM_PLAN_CODE_FOR_STARTUPS=<for payments>
HEALTHCHECK_SECRET=<shared secret for /api/health/, sent as X-Health-Key header; empty disables auth>