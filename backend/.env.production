# Production Environment Variables for Supabase
# DO NOT commit this file with actual values

# Django Settings
DEBUG=0
SECRET_KEY=your-production-secret-key-here
ENV=production
ALLOWED_HOSTS=tiaago.com,www.tiaago.com,api.tiaago.com

# Database Configuration (Supabase)
DB_URL=postgresql://postgres.[your-project-ref]:[your-password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Redis Configuration (Production Redis service)
REDIS_HOST=your-production-redis-instance-ip

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-production-email@gmail.com
EMAIL_HOST_PASSWORD=your-production-app-password
DEFAULT_FROM_EMAIL=Tiaago <no-reply@tiaago.com>

# Payment Gateway (Live Keys)
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key
PAYSTACK_PRIVATE_KEY=sk_live_your_paystack_private_key
FLW_PUB_KEY=your-production-flutterwave-public-key
FLW_SEC_KEY=your-production-flutterwave-secret-key

# Currency API
CURRENCY_PRIVATE_KEY=your_production_currency_api_key

# Daily API (for video calls)
DAILY_API_TOKEN=your_production_daily_api_token

# AI Services
ELEVENLABS_API_KEY=your-production-elevenlabs-api-key
OPENAI_API_KEY=your-production-openai-api-key
DEEPGRAM_API_KEY=your-production-deepgram-api-key

# Stripe (Live)
STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PRICE_ID_STANDARD_JOB_POSTING=price_your_production_stripe_price_id
STRIPE_WEBHOOK_SECRET=whsec_your_production_stripe_webhook_secret

# Payment Plan Codes (Live)
PAYSTACK_BASIC_PLAN_CODE_FOR_TALENTS=PLN_live_basic_talents
PAYSTACK_PREMIUM_PLAN_CODE_FOR_TALENTS=PLN_live_premium_talents
PAYSTACK_BASIC_PLAN_CODE_FOR_STARTUPS=PLN_live_basic_startups
PAYSTACK_PREMIUM_PLAN_CODE_FOR_STARTUPS=PLN_live_premium_startups
FLW_BASIC_PLAN_CODE_FOR_TALENTS=PLN_flw_live_basic_talents
FLW_PREMIUM_PLAN_CODE_FOR_TALENTS=PLN_flw_live_premium_talents
FLW_BASIC_PLAN_CODE_FOR_STARTUPS=PLN_flw_live_basic_startups
FLW_PREMIUM_PLAN_CODE_FOR_STARTUPS=PLN_flw_live_premium_startups

# CORS and Security
CORS_ALLOWED_ORIGINS=https://tiaago.com,https://www.tiaago.com
CSRF_TRUSTED_ORIGINS=https://tiaago.com,https://www.tiaago.com
CORS_ALLOW_CREDENTIALS=True

# Frontend URLs
FRONTEND_URL=https://www.tiaago.com
FRONTEND_SUCCESS_URL=https://www.tiaago.com/payment/success
FRONTEND_CANCEL_URL=https://www.tiaago.com/payment/cancel
FRONTEND_CALLBACK_URL=https://www.tiaago.com/payment/callback

# Service Pricing
SERVICE_PRICING={"resume_screening": 3, "non_technical_assessment": 5, "technical_assessment": 9, "interview": 60}
USD_PRICE=1.0
NAIRA_EXCHANGE_RATE=1600
PAYG_NAIRA_EXCHANGE_RATE=1600

# Cloudinary (Production)
CLOUDINARY_CLOUD_NAME=your-production-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-production-cloudinary-api-key
CLOUDINARY_API_SECRET=your-production-cloudinary-api-secret

# Max Concurrent Interviews
MAX_CONCURRENT_INTERVIEWS=10