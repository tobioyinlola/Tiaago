# Staging Environment Variables for Supabase
# DO NOT commit this file with actual values

# Django Settings
DEBUG=0
SECRET_KEY=your-staging-secret-key-here
ENV=staging
ALLOWED_HOSTS=staging.tiaago.com,www.staging.tiaago.com,api-staging.tiaago.com

# Database Configuration (Supabase)
DB_URL=postgresql://postgres.[your-project-ref]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Redis Configuration (Cloud Memorystore or Redis service)
REDIS_HOST=your-redis-staging-instance-ip

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-staging-email@gmail.com
EMAIL_HOST_PASSWORD=your-staging-app-password
DEFAULT_FROM_EMAIL=Tiaago Staging <no-reply@tiaago.com>

# Payment Gateway (Test Keys)
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_PRIVATE_KEY=sk_test_your_paystack_private_key
FLW_PUB_KEY=your-staging-flutterwave-public-key
FLW_SEC_KEY=your-staging-flutterwave-secret-key

# Bachs (default wallet top-up gateway -- sandbox)
BACHS_ENVIRONMENT=sandbox
BACHS_API_KEY_SANDBOX=sk_sandbox_your_bachs_sandbox_key
BACHS_API_KEY_LIVE=
BACHS_WEBHOOK_SECRET=your_bachs_webhook_signing_secret
BACHS_TOPUP_PRODUCT_ID_NGN=prod_your_bachs_ngn_topup_product_id
BACHS_TOPUP_PRODUCT_ID_USD=prod_your_bachs_usd_topup_product_id

# Currency API
CURRENCY_PRIVATE_KEY=your_currency_api_key

# Daily API (for video calls)
DAILY_API_TOKEN=your_daily_api_token

# AI Services
ELEVENLABS_API_KEY=your-elevenlabs-api-key
OPENAI_API_KEY=your-openai-api-key
DEEPGRAM_API_KEY=your-deepgram-api-key

# Stripe (Test)
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PRICE_ID_STANDARD_JOB_POSTING=price_your_stripe_price_id
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Payment Plan Codes (Test)
PAYSTACK_BASIC_PLAN_CODE_FOR_TALENTS=PLN_test_basic_talents
PAYSTACK_PREMIUM_PLAN_CODE_FOR_TALENTS=PLN_test_premium_talents
PAYSTACK_BASIC_PLAN_CODE_FOR_STARTUPS=PLN_test_basic_startups
PAYSTACK_PREMIUM_PLAN_CODE_FOR_STARTUPS=PLN_test_premium_startups
FLW_BASIC_PLAN_CODE_FOR_TALENTS=PLN_flw_test_basic_talents
FLW_PREMIUM_PLAN_CODE_FOR_TALENTS=PLN_flw_test_premium_talents
FLW_BASIC_PLAN_CODE_FOR_STARTUPS=PLN_flw_test_basic_startups
FLW_PREMIUM_PLAN_CODE_FOR_STARTUPS=PLN_flw_test_premium_startups

# CORS and Security
CORS_ALLOWED_ORIGINS=https://staging.tiaago.com,https://www.staging.tiaago.com
CSRF_TRUSTED_ORIGINS=https://staging.tiaago.com,https://www.staging.tiaago.com
CORS_ALLOW_CREDENTIALS=True

# Frontend URLs
FRONTEND_URL=https://staging.tiaago.com
FRONTEND_SUCCESS_URL=https://staging.tiaago.com/payment/success
FRONTEND_CANCEL_URL=https://staging.tiaago.com/payment/cancel
FRONTEND_CALLBACK_URL=https://staging.tiaago.com/payment/callback

# Service Pricing
SERVICE_PRICING={"resume_screening": 3, "non_technical_assessment": 5, "technical_assessment": 9, "interview": 60}
USD_PRICE=1.0
NAIRA_EXCHANGE_RATE=1600
PAYG_NAIRA_EXCHANGE_RATE=1600

# Cloudinary (Optional for staging)
CLOUDINARY_CLOUD_NAME=your-staging-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-staging-cloudinary-api-key
CLOUDINARY_API_SECRET=your-staging-cloudinary-api-secret

# Max Concurrent Interviews
MAX_CONCURRENT_INTERVIEWS=5
