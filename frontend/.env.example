NEXT_PUBLIC_API_URL=http://abc.com
MIXPANEL_TOKEN=ddhdhdhh

# Google OAuth (Sign in with Google)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# BetterStack log management
NEXT_PUBLIC_BETTERSTACK_SOURCE_TOKEN=
NEXT_PUBLIC_BETTERSTACK_HOST=

# Nango (nango.dev) — ATS integrations. No frontend env var needed: Nango
# retired the public-key frontend flow in March 2025, so @nangohq/frontend
# only ever receives a short-lived Connect session token fetched from our
# own backend (POST /api/ats/connect-session/) at click-time — never a key.
# The real secret (NANGO_SECRET_KEY) lives only in the backend's .env.